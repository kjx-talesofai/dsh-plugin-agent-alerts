{
  "name": "dsh-plugin-agent-alerts",
  "version": "0.3.3",
  "type": "module",
  "description": "Hear and see the moment an agent finishes, asks you a question, or needs your approval \u2014 a desktop notification and a sound of your choosing.",
  "license": "MIT",
  "author": "Jiaxin Kou <https://hypersampling.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjx-talesofai/dsh-plugin-agent-alerts.git"
  },
  "homepage": "https://github.com/kjx-talesofai/dsh-plugin-agent-alerts",
  "bugs": "https://github.com/kjx-talesofai/dsh-plugin-agent-alerts/issues",
  "icon": "./assets/icon.svg",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets/icon.svg",
    "assets/duo_finish.mp3",
    "assets/duo_question.mp3",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "desktop-notification",
    "sound",
    "alert",
    "chime",
    "turn",
    "attention"
  ],
  "scripts": {
    "test": "node --test tests/plugin.test.mjs"
  }
}
